{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "devices-route": {
        "ClusterId": "devices-cluster",
        "Match": { "Path": "/api/v1/devices/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1/devices" } ]
      },
      "heating-route": {
        "ClusterId": "heating-cluster",
        "Match": { "Path": "/api/v1/heating/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1/heating" } ]
      },
      "lighting-route": {
        "ClusterId": "lighting-cluster",
        "Match": { "Path": "/api/v1/lighting/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1/lighting" } ]
      },
      "access-route": {
        "ClusterId": "access-cluster",
        "Match": { "Path": "/api/v1/access/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1/access" } ]
      },
      "monitoring-route": {
        "ClusterId": "monitoring-cluster",
        "Match": { "Path": "/api/v1/monitoring/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1/monitoring" } ]
      },
      "telemetry-route": {
        "ClusterId": "telemetry-cluster",
        "Match": { "Path": "/api/v1/telemetry/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1/telemetry" } ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1/identity" } ]
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": { "Path": "/api/v1/billing/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1/billing" } ]
      }
    },

    "Clusters": {
      "devices-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5001" } }
      },
      "heating-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5002" } }
      },
      "lighting-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5003" } }
      },
      "access-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5004" } }
      },
      "monitoring-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5005" } }
      },
      "telemetry-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5006" } }
      },
      "identity-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5007" } }
      },
      "billing-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5008" } }
      }
    }
  }
}
