@startuml erd
title ER diagram - WarmHouse target data model (logical, cross-service)

entity "User" as user {
  * id : uuid <<PK>>
  --
  name : varchar
  email : varchar
  password_hash : varchar
  created_at : timestamp
}

entity "House" as house {
  * id : uuid <<PK>>
  --
  # user_id : uuid <<FK>>
  address : varchar
  created_at : timestamp
}

entity "DeviceType" as deviceType {
  * id : uuid <<PK>>
  --
  name : varchar
  unit : varchar
  description : varchar
}

entity "Module" as module {
  * id : uuid <<PK>>
  --
  # device_type_id : uuid <<FK>>
  name : varchar
  manufacturer : varchar
  protocol : varchar
  price : decimal
}

entity "Device" as device {
  * id : uuid <<PK>>
  --
  # module_id : uuid <<FK>>
  # house_id : uuid <<FK>>
  serial_number : varchar
  status : varchar
  installed_at : timestamp
}

entity "DeviceState" as deviceState {
  * id : uuid <<PK>>
  --
  # device_id : uuid <<FK>>
  desired_value : varchar
  actual_value : varchar
  updated_at : timestamp
}

entity "TelemetryData" as telemetry {
  * id : uuid <<PK>>
  --
  # device_id : uuid <<FK>>
  metric : varchar
  value : double
  unit : varchar
  measured_at : timestamp
  received_at : timestamp
}

entity "ThresholdRule" as thresholdRule {
  * id : uuid <<PK>>
  --
  # house_id : uuid <<FK>>
  # device_id : uuid <<FK, nullable>>
  metric : varchar
  operator : varchar
  value : double
}

entity "Subscription" as subscription {
  * id : uuid <<PK>>
  --
  # user_id : uuid <<FK>>
  plan : varchar
  status : varchar
  start_date : timestamp
  end_date : timestamp
}

user ||--o{ house : "one user has many houses,\neach house has one user"
house ||--o{ device : "one house has many devices,\neach device belongs to one house"
deviceType ||--o{ module : "one type has many module products"
module ||--o{ device : "one module is installed as many devices"
device ||--o| deviceState : "one device has one current state"
device ||--o{ telemetry : "one device generates many telemetry records"
house ||--o{ thresholdRule : "one house has many threshold rules"
device |o--o{ thresholdRule : "a rule may be scoped to one device,\nor to null (whole house)"
user ||--o{ subscription : "one user has many subscriptions over time"

@enduml
